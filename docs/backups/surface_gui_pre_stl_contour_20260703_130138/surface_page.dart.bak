class _ScanProfileInfo {
  final String profile;
  final int pointCount;
  final int invalidCount;
  final double modified;
  final String? jsonPath;
  final String? csvPath;

  _ScanProfileInfo({
    required this.profile,
    required this.pointCount,
    required this.invalidCount,
    required this.modified,
    required this.jsonPath,
    required this.csvPath,
  });

  factory _ScanProfileInfo.fromJson(Map<String, dynamic> json) {
    return _ScanProfileInfo(
      profile: json['profile']?.toString() ?? '',
      pointCount: _asInt(json['point_count']) ?? 0,
      invalidCount: _asInt(json['invalid_count']) ?? 0,
      modified: _asDouble(json['modified']) ?? 0,
      jsonPath: json['json_path']?.toString(),
      csvPath: json['csv_path']?.toString(),
    );
  }

  String get formattedTime {
    if (modified <= 0) return '--';
    final date = DateTime.fromMillisecondsSinceEpoch((modified * 1000).round());
    return '${date.month}/${date.day} '
        '${date.hour.toString().padLeft(2, '0')}:'
        '${date.minute.toString().padLeft(2, '0')}';
  }

  String get fileHint {
    final path = jsonPath ?? csvPath;
    if (path == null || path.isEmpty) return '';
    return path.split(RegExp(r'[/\\]')).last;
  }
}

class _ScanProfileDialog extends StatelessWidget {
  final List<_ScanProfileInfo> profiles;

  const _ScanProfileDialog({required this.profiles});

  @override
  Widget build(BuildContext context) {
    return Dialog(
      backgroundColor: const Color(0xFF2C3034),
      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(8)),
      child: ConstrainedBox(
        constraints: const BoxConstraints(maxWidth: 500, maxHeight: 500),
        child: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            Container(
              padding: const EdgeInsets.all(16),
              decoration: const BoxDecoration(
                border: Border(bottom: BorderSide(color: Colors.white10)),
              ),
              child: Row(
                children: [
                  const Icon(Icons.history, color: Colors.blue, size: 20),
                  const SizedBox(width: 12),
                  const Text(
                    '选择扫描点云',
                    style: TextStyle(
                      color: Colors.white,
                      fontSize: 16,
                      fontWeight: FontWeight.w600,
                    ),
                  ),
                  const SizedBox(width: 10),
                  Text(
                    '${profiles.length} 个历史文件',
                    style: const TextStyle(color: Colors.white38, fontSize: 12),
                  ),
                  const Spacer(),
                  IconButton(
                    icon: const Icon(Icons.close, size: 20),
                    color: Colors.white60,
                    onPressed: () => Navigator.pop(context),
                  ),
                ],
              ),
            ),
            Flexible(
              child: ListView.builder(
                shrinkWrap: true,
                itemCount: profiles.length,
                itemBuilder: (context, index) {
                  final info = profiles[index];
                  return ListTile(
                    dense: true,
                    leading: CircleAvatar(
                      backgroundColor: Colors.blue.shade800,
                      radius: 16,
                      child: Text(
                        '${index + 1}',
                        style: const TextStyle(
                          color: Colors.white,
                          fontSize: 12,
                          fontWeight: FontWeight.w600,
                        ),
                      ),
                    ),
                    title: Text(
                      info.profile,
                      style: const TextStyle(
                        color: Colors.white,
                        fontSize: 14,
                        fontWeight: FontWeight.w500,
                      ),
                    ),
                    subtitle: Wrap(
                      spacing: 8,
                      runSpacing: 2,
                      children: [
                        Text(
                          info.formattedTime,
                          style: const TextStyle(
                            color: Colors.white54,
                            fontSize: 12,
                          ),
                        ),
                        Text(
                          '${info.pointCount} 点',
                          style: const TextStyle(
                            color: Colors.white54,
                            fontSize: 12,
                          ),
                        ),
                        if (info.invalidCount > 0) ...[
                          Text(
                            '${info.invalidCount} 异常',
                            style: const TextStyle(
                              color: Colors.orange,
                              fontSize: 12,
                            ),
                          ),
                        ],
                        if (info.fileHint.isNotEmpty)
                          Text(
                            info.fileHint,
                            style: const TextStyle(
                              color: Colors.white38,
                              fontSize: 12,
                            ),
                          ),
                      ],
                    ),
                    onTap: () => Navigator.pop(context, info),
                  );
                },
              ),
            ),
          ],
        ),
      ),
    );
  }
}
